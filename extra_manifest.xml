    <!-- Android 11+ package visibility: let the app find the phone's speech recognizer and
         text-to-speech engine (voice input / spoken replies). -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <!-- "open whatsapp": see apps that have a launcher icon (no QUERY_ALL_PACKAGES needed) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
